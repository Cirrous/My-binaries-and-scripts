#!/bin/bash

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/bin/colors.sh"

# Target directory for local user binaries
TARGET_DIR="$HOME/.local/bin"

show_help() {
  echo "Script Deployer - Links all executable scripts from the current directory to $TARGET_DIR"
  echo ""
  echo "Usage:"
  echo "  $0             Link all scripts in the current directory (skipping itself)"
  echo "  $0 -h, --help  Show this help message"
  exit 0
}

if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
  show_help
fi

cd "$SCRIPT_DIR/bin"
mkdir -p "$TARGET_DIR"

printf '%b==>%b Deploying scripts to %b%s%b\n\n' "$CYAN$BOLD" "$RESET" "$BOLD" "$TARGET_DIR" "$RESET"

SCRIPT_NAME=$(basename "$0")
COPY_COUNT=0

for file in *; do
  if [ -f "$file" ] && [ -x "$file" ] && [ "$file" != "$SCRIPT_NAME" ]; then
    cp -pf "$file" "$TARGET_DIR/$file"
    printf '  %b+%b copied %s\n' "$GREEN" "$RESET" "$file"
    ((COPY_COUNT++))
  fi
done

cp -pf colors.sh "$TARGET_DIR/colors.sh"

printf '\n'
if [ "$COPY_COUNT" -eq 0 ]; then
  printf '%b!%b No executable scripts found in the current directory.\n' "$YELLOW$BOLD" "$RESET"
  printf '  Hint: Make sure your scripts are executable (chmod +x scriptname).\n'
else
  printf '%b==>%b Successfully deployed %b%s%b script(s)!\n' "$GREEN$BOLD" "$RESET" "$BOLD" "$COPY_COUNT" "$RESET"
fi
